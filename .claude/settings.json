{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/checar-encerramento.mjs",
              "--hook"
            ],
            "timeout": 30,
            "statusMessage": "Conferindo se a sessão pode mesmo encerrar..."
          }
        ]
      }
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}
